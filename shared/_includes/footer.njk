  <footer class="site-footer">
    <div class="container footer-inner">
      <a class="footer-brand" href="/"><span class="brand-mark" aria-hidden="true"></span><span>{{ site.name | escape }}</span></a>
      <div class="footer-actions">
        <div class="footer-appearance" hidden>
          <fieldset class="theme-switch">
            <legend class="visually-hidden">Appearance</legend>
            <label><input class="visually-hidden" type="radio" name="theme" value="light"><span>Light</span></label>
            <label><input class="visually-hidden" type="radio" name="theme" value="dark"><span>Dark</span></label>
            <label><input class="visually-hidden" type="radio" name="theme" value="auto" checked><span>Auto</span></label>
          </fieldset>
        </div>
        <nav aria-label="Footer navigation">
          {% for item in site.footerNavigation %}<a href="{{ item.url | escape }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title | escape }}</a>{% endfor %}
          <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
        </nav>
      </div>
    </div>
  </footer>
