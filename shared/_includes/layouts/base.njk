<!doctype html>
<html lang="en" data-theme-storage-key="{{ site.themeStorageKey | escape }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="{{ site.themeColor | escape }}">
  <meta name="description" content="{{ (description or site.description) | escape }}">
  <title>{{ title | escape }}{% if not home %} | {{ site.name }}{% endif %}</title>
  <link rel="canonical" href="{{ (canonicalPath or page.url) | absoluteUrl(site.url) }}">
  {% if site.blog %}<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.name | escape }} Blog">{% endif %}
  <meta property="og:title" content="{{ title | escape }}">
  <meta property="og:description" content="{{ (description or site.description) | escape }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{% if isPost %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
  <meta name="twitter:card" content="summary">
  <link rel="icon" type="image/svg+xml" href="/logo.svg">
  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/brand.css">
  {% if not home %}<link rel="stylesheet" href="/content.css">{% endif %}
  {% if documentation %}<link rel="stylesheet" href="/docs.css">{% endif %}
  {% if quickReference %}<link rel="stylesheet" href="/quick-reference.css"><script type="module" src="/reference-assets/quick-reference.js"></script>{% endif %}
  {% if matrixExportBase %}<link rel="alternate" type="text/markdown" href="{{ matrixExportBase }}README.md"><link rel="alternate" type="application/json" href="{{ matrixExportBase }}reference.json">{% endif %}
  <script src="/main.js" defer></script>
</head>
<body id="top">
  <a class="skip-link" href="#main">Skip to content</a>
{% include "header.njk" %}
  <main id="main"{% if not home %} class="content-main{% if documentation %} docs-main{% endif %}"{% endif %}>
{{ content | safe }}
  </main>
{% include "footer.njk" %}
  <p id="copy-status" class="visually-hidden" role="status" aria-live="polite"></p>
</body>
</html>
