# Copy to .env and fill in the FTP account credentials. Never commit .env.
OVH_FTP_HOST=ftp.cluster129.hosting.ovh.net
OVH_FTP_PORT=21
OVH_FTP_USER=
OVH_FTP_PASSWORD=

# true requires explicit FTP-over-TLS. Set false only for a plain FTP connection.
OVH_FTP_SECURE=true

# The site's Root folder in OVHcloud, relative to the FTP login directory.
# This is different from the account's filesystem home, such as /home/username.
OVH_FTP_REMOTE_DIR=www
