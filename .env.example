# Shared template for site-specific publishing settings. A root .env is not loaded.
# Copy THIS file to the website directory you want to configure:
#
#   .env.example -> sites/cascada.dev/.env
#   .env.example -> sites/casai.run/.env
#
# Fill in all required values in the copied file, even for a shared hosting account.
# Use plain OVH_SFTP_* names in each file, without CASCADA_ or CASAI_ prefixes.
# Never put credentials in _data/, public/, or this tracked example.
# Actual .env files are Git-ignored and are not included in website builds.
#
# Publishing one site loads only that site's file. Publishing all loads each
# file independently; credentials and destinations are never inherited.
#
# Optional shell/CI overrides use the site's envPrefix from sites.json:
# e.g. CASAI_OVH_SFTP_PASSWORD overrides OVH_SFTP_PASSWORD for casai.run only.
# Unprefixed shell variables are not used as shared publishing defaults.

# SFTP uses SSH encryption on port 22 and the same hosting login/password.
# Requires SFTP access to be enabled for this OVHcloud user.
OVH_SFTP_HOST=ftp.cluster129.hosting.ovh.net
OVH_SFTP_PORT=22
OVH_SFTP_USER=
OVH_SFTP_PASSWORD=

# Optional verified SSH fingerprint; otherwise the first successful connection's
# key is saved in .cache/sftp-host-keys/ and later key changes are rejected.
# OVH_SFTP_HOST_KEY_SHA256=SHA256:...

# This site's existing Root folder in OVHcloud's My sites / Multisite settings,
# relative to the SFTP account's home directory (normally www for each account).
# The account's filesystem home, such as /home/username, is not the site folder.
# Use the actual configured folder. There is no fallback to another site's target.
OVH_SFTP_REMOTE_DIR=
