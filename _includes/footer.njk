            <label><input class="visually-hidden" type="radio" name="theme" value="dark"><span>Dark</span></label>
            <label><input class="visually-hidden" type="radio" name="theme" value="auto" checked><span>Auto</span></label>
          </fieldset>
        </div>
        <nav aria-label="Footer navigation">
          <a href="https://github.com/geleto/cascada">GitHub <span aria-hidden="true">↗</span></a>
          <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
          <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
        </nav>
      </div>
    </div>
  </footer>
