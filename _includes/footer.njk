      <a class="footer-brand" href="/"><span class="brand-mark" aria-hidden="true"></span><span>Cascada</span></a>
      <div class="footer-actions">
        <div class="footer-appearance" hidden>
          <fieldset class="theme-switch">
            <legend class="visually-hidden">Appearance</legend>
